# Copy to .env on the server host. Never commit the populated copy.
# 云端：在服务器上生成哈希与随机串后粘贴；不要把真实值写进 Git / 对话记录 / Issue。

TASKCOORD_ADMIN_USERNAME=admin
TASKCOORD_ADMIN_PASSWORD_HASH=
TASKCOORD_SESSION_SECRET=
TASKCOORD_HEALTH_TOKEN=
TASKCOORD_CONFIG=config/service.toml

# 可选：覆盖 config/service.toml 中的 [database].url（密码需 URL 编码）
# TASKCOORD_DATABASE_URL=mysql+pymysql://taskcoord:<URL_ENCODED_PASSWORD>@127.0.0.1:3306/taskcoord?charset=utf8mb4

# 可选：管理员会话 TTL（小时，1–168，默认 12）
# TASKCOORD_SESSION_TTL_HOURS=12
